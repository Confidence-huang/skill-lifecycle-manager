{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-lifecycle-manager.local/schemas/v5/artifact-manifest.schema.json",
  "title": "Capability artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "artifactID",
    "skillName",
    "identity",
    "treeEntries"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "documentType": {"const": "CAPABILITY_ARTIFACT_MANIFEST"},
    "artifactID": {"$ref": "common.schema.json#/$defs/artifactID"},
    "skillName": {"$ref": "common.schema.json#/$defs/skillName"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityVersion",
        "sourceType",
        "canonicalSource",
        "resolvedCommit",
        "skillPath",
        "contentPolicyVersion",
        "contentSHA256"
      ],
      "properties": {
        "identityVersion": {"const": 1},
        "sourceType": {"enum": ["GIT", "PACKAGE", "LOCAL"]},
        "canonicalSource": {"type": "string", "minLength": 1, "maxLength": 4096},
        "resolvedCommit": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "null"}
          ]
        },
        "skillPath": {
          "oneOf": [
            {"const": "."},
            {"$ref": "common.schema.json#/$defs/relativePath"}
          ]
        },
        "contentPolicyVersion": {"const": "logical-tree-sha256-v1"},
        "contentSHA256": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"sourceType": {"const": "GIT"}}},
          "then": {"properties": {"resolvedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
          "else": {"properties": {"resolvedCommit": {"type": "null"}}}
        }
      ]
    },
    "treeEntries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/treeEntry"}
    }
  }
}
